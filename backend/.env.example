# Copia questo file in ".env" e sostituisci i valori con i tuoi dati reali

# Stringa di connessione a MongoDB Atlas
# Formato: mongodb+srv://<utente>:<password>@<cluster>.mongodb.net/<nomeDB>
MONGODB_URI=mongodb+srv://utente:password@cluster.mongodb.net/TrentoApartmentService

# Porta su cui gira il server Express (default 3000)
PORT=3000

# Chiave usata per firmare i token JWT
JWT_SECRET=una_chiave_lunga_e_sicura

# Durata del token JWT
JWT_EXPIRES_IN=7d

# Resend / Email
# API key Resend
RESEND_API_KEY=your_resend_api_key

# Mittente verificato su Resend
RESEND_FROM="Trento Apartment Service <no-reply@recover.tas.tn.it>"

# URL pubblico del frontend
FRONTEND_URL=http://localhost:5173

# Timeout del token di reset
PASSWORD_RESET_TTL_MINUTES=60
