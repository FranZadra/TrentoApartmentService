# Copia questo file in ".env" e sostituisci i valori con i tuoi dati reali
# Il file .env NON va mai committato su git

# Stringa di connessione a MongoDB Atlas
# Formato: mongodb+srv://<utente>:<password>@<cluster>.mongodb.net/<nomeDB>
MONGODB_URI=mongodb+srv://utente:password@cluster.mongodb.net/TrentoApartmentService

# Porta su cui gira il server Express (default 3000)
PORT=3000
