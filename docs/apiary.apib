                        "disponibile": true
                    }
                ]
            }
        }

+ Response 404 (application/json)

        {
            "success": false,
            "message": "Appartamento non trovato"
        }

+ Response 500 (application/json)

        {
            "success": false,
            "message": "Errore interno del server"
        }

### Aggiorna appartamento [PUT]

Aggiorna i campi di un appartamento esistente. Richiede autenticazione JWT e che l'utente
autenticato sia il proprietario (`amministratoreId`) dell'appartamento.

Tutti i campi del body sono opzionali, ma almeno uno deve essere presente.
I campi non inclusi nel body non vengono modificati.
Se l'`indirizzo` viene modificato, la `posizione` viene ricalcolata via geocoding.

+ Request (application/json)

    + Headers

            Authorization: Bearer <jwt_token>

    + Body

            {
                "numStanze": 4,
                "terrazzo": true,
                "classeEnergetica": "A1",
                "camere": [
                    {
                        "prezzo": 400,
                        "tipo": "SINGOLA",
                        "mq": 14,
                        "numFinestre": 2,
                        "disponibile": true
                    }
                ]
            }

+ Response 200 (application/json)

        {
            "success": true,
            "message": "Appartamento aggiornato con successo",
            "data": {
                "_id": "665f1a2b3c4d5e6f7a8b9c0d",
                "indirizzo": {
                    "via": "Via Roma",
                    "numero": 10,
                    "città": "Trento",
                    "CAP": "38122",
                    "Stato": "Italia"
                },
                "mqTot": 90,
                "perStudenti": false,
                "numStanze": 4,
                "numBagni": 2,
                "foto": [],
                "terrazzo": true,
                "lavatrice": false,
                "classeEnergetica": "A1",
                "amministratoreId": "665f1a2b3c4d5e6f7a8b9c01",
                "camere": [
                    {
                        "prezzo": 400,
                        "tipo": "SINGOLA",
                        "mq": 14,
                        "numFinestre": 2,
                        "disponibile": true
                    }
                ]
            }
        }

+ Response 400 (application/json)

        {
            "success": false,
            "message": "Errori di validazione nel body",
            "errors": [
                "classeEnergetica deve essere una di: A4, A3, A2, A1, B, C, D, E, F, G"
            ]
        }

+ Response 401 (application/json)

        {
            "success": false,
            "message": "Token non fornito. Usa Authorization: Bearer <token>"
        }

+ Response 403 (application/json)

        {
            "success": false,
            "message": "Token non valido"
        }

+ Response 404 (application/json)

        {
            "success": false,
            "message": "Appartamento non trovato"
        }

### Elimina appartamento [DELETE]

Elimina un appartamento. Richiede autenticazione JWT e che l'utente sia il proprietario.

Se al momento dell'eliminazione esistono annunci collegati all'appartamento, la risposta include
il campo `warnings` con il conteggio degli annunci orfani (non vengono eliminati automaticamente).

+ Request

    + Headers

            Authorization: Bearer <jwt_token>

+ Response 200 (application/json)

        {
            "success": true,
            "message": "Appartamento eliminato con successo",
            "data": {
                "_id": "665f1a2b3c4d5e6f7a8b9c0d",
                "indirizzo": {
                    "via": "Via Roma",
                    "numero": 10,
                    "città": "Trento",
                    "CAP": "38122",
                    "Stato": "Italia"
                },
                "mqTot": 90,
                "perStudenti": false,
                "numStanze": 3,
                "numBagni": 2,
                "amministratoreId": "665f1a2b3c4d5e6f7a8b9c01"
            },
            "warnings": "Erano presenti 2 annunci associati"
        }

+ Response 401 (application/json)

        {
            "success": false,
            "message": "Token non fornito. Usa Authorization: Bearer <token>"
        }

+ Response 403 (application/json)

        {
            "success": false,
            "message": "Token non valido"
        }

+ Response 404 (application/json)

        {
            "success": false,
            "message": "Appartamento non trovato"
        }

+ Response 500 (application/json)

        {
            "success": false,
            "message": "Errore interno del server"
        }

## Contatto Admin [/api/v1/appartamenti/{id}/contatto-admin]

+ Parameters
    + id (string, required) - ID dell'appartamento

### Contatto WhatsApp dell'amministratore [GET]

Restituisce nome e link WhatsApp dell'amministratore dell'appartamento.
Riservato agli utenti autenticati: alimenta il pulsante "Contatta su WhatsApp" nella pagina dell'annuncio.

+ Request

    + Headers

            Authorization: Bearer <jwt_token>

+ Response 200 (application/json)

        {
            "success": true,
            "data": {
                "nome": "Luca",
                "cognome": "Bianchi",
                "telefono": "+39 351 1234567",
                "linkWhatsApp": "https://wa.me/393511234567?text=Salve%2C%20sono%20interessato..."
            }
        }

+ Response 401 (application/json)

        {
            "success": false,
            "message": "Token non fornito. Usa Authorization: Bearer <token>"
        }

+ Response 404 (application/json)

        {
            "success": false,
            "message": "Appartamento o amministratore non trovato"
        }

+ Response 500 (application/json)

        {
            "success": false,
            "message": "Errore interno del server"
        }

## Associa Inquilino [/api/v1/appartamenti/{appartamentoId}/associa-inquilino]

+ Parameters
    + appartamentoId (string, required) - MongoDB ObjectId dell'appartamento

### Associa un inquilino a un appartamento [POST]

Crea il legame amministratore→inquilino tramite contratto. Eseguibile solo dall'amministratore
proprietario. L'utente, indicato per email, deve essere verificato/inquilino e senza contratti attivi.

Se l'appartamento ha già un contratto attivo, l'utente viene aggiunto come coinquilino;
altrimenti si crea un nuovo contratto (servono `dataInizio`, `dataFine`, `canoneMensile` e `tipoContratto`).
A fine operazione l'utente assume il ruolo `inquilino`.

+ Request (application/json)

    + Headers

            Authorization: Bearer <jwt_token>

    + Body

            {
                "email": "greta.delai@example.com",
                "dataInizio": "2026-01-01",
                "dataFine": "2026-12-31",
                "canoneMensile": 850,
                "tipoContratto": "Residenziale"
            }

+ Response 200 (application/json)

        {
            "success": true,
            "message": "Greta Delai associato all'appartamento",
            "data": {
                "_id": "665f1a2b3c4d5e6f7a8b9c10",
                "idAppartamento": "665f1a2b3c4d5e6f7a8b9c0d",
                "idInquilini": [
                    "665f1a2b3c4d5e6f7a8b9c0d",
                    "665f1a2b3c4d5e6f7a8b9c0e"
                ],
                "dataInizio": "2026-01-01T00:00:00.000Z",
                "dataFine": "2026-12-31T00:00:00.000Z",
                "canoneMensile": 850,
                "stato": "attivo",
                "tipoContratto": "Residenziale"
            }
        }

+ Response 400 (application/json)

        {
            "success": false,
            "message": "Email mancante, utente non verificato o dati contratto incompleti"
        }

+ Response 403 (application/json)

        {
            "success": false,
            "message": "Accesso non autorizzato"
        }

+ Response 404 (application/json)

        {
            "success": false,
            "message": "Nessun utente registrato con questa email"
        }

+ Response 409 (application/json)

        {
            "success": false,
            "message": "L'utente ha già un contratto attivo"
        }

+ Response 500 (application/json)

        {
            "success": false,
            "message": "Errore interno del server"
        }

